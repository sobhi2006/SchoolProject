{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionString":{
    "DefaultConnection": "Server=.;DataBase=SchoolProject;Integrated security=SSPI;TrustServerCertificate=true;"
  },
  "jwtSettings" :{
    "secret": "School-Project-Sobhi-with-Clean-Architecture",
    "issuer": "SchoolProject",
    "audience": "audience",
    "validateAudience": true,
    "validateIssuer": true,
    "validateLifetime": true,
    "validateIssuerSigningKey": true,
    "TokenExpiredInMinutes": 30,
    "RefreshTokenExpiredInDays": 7
  },
  "Serilog":{
    "Using": ["Serilog.Sinks.MSSqlServer", "Serilog.Sinks.Console"],
    "MinimumLevel" : {
      "Default" :"Information",
      "Override":{
        "Microsoft": "Error"
      }
    },
    "WriteTo":[
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "ConnectionString" :"Server=.;DataBase=SchoolProject;Integrated security=SSPI;TrustServerCertificate=true;",
          "TableName": "ProjectLogs",
          "AutoCreateSqlTable": true
        }
      }
    ]
  }
}
